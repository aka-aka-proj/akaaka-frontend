{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:ci-contract": "sh scripts/ci/test-workflow-contract.sh",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "test:manifest": "node scripts/validate-playwright-manifest.mjs",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.0.3",
    "marked": "^18.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "latest",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-mcp": "^0.1.3",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.71.0",
    "playwright": "latest",
    "storybook": "^10.5.7",
    "typescript": "~6.0.2"
  }
}
