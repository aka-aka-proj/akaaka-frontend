#!/bin/sh

set -eu

echo "Running frontend pre-push validation..."
npm run lint
npm test
npm run build

run_browser_checks=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue

  changed_files=""
  if git rev-parse --verify origin/preview >/dev/null 2>&1; then
    changed_files=$(git diff --name-only "origin/preview...${local_sha}" || true)
  elif [ "${remote_sha}" != "0000000000000000000000000000000000000000" ]; then
    changed_files=$(git diff --name-only "${remote_sha}" "${local_sha}" || true)
  else
    changed_files=$(git show --format= --name-only "${local_sha}" || true)
  fi

  while IFS= read -r file; do
    case "$file" in
      src/*.test.ts|src/*.test.tsx|src/*/*.test.ts|src/*/*.test.tsx|src/*/*/*.test.ts|src/*/*/*.test.tsx)
        ;;
      src/*|tests/*|public/*|index.html|vite.config.*|playwright.config.ts|scripts/playwright-*|package-lock.json)
        run_browser_checks=1
        ;;
    esac
  done <<EOF
$changed_files
EOF
done

if [ "$run_browser_checks" -eq 1 ]; then
  echo "Browser-affecting changes detected; running Chromium Playwright checks..."
  # Keep the local browser gate focused on the affected event-form routes;
  # the complete Chromium matrix remains enforced by PR CI.
  VITE_SUPABASE_URL="${VITE_SUPABASE_URL:-http://127.0.0.1:54321}" \
  VITE_SUPABASE_ANON_KEY="${VITE_SUPABASE_ANON_KEY:-ci-public-test-key}" \
  BROWSER_FILTER=chromium npx playwright test tests/authenticated.spec.ts --project=chromium-desktop --project=chromium-mobile --grep "(/events/new|/events/synthetic-event/edit)" --workers=1
  npm run test:manifest
fi

echo "Frontend pre-push validation passed."
